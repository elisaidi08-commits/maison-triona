{
  "name": "maison-triona",
  "version": "0.1.0",
  "private": true,
  "description": "Site vitrine de Maison Triona — by K.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/check-content.mjs --si-indexable",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y",
    "test:unit": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON 'tests/unit/*.test.ts'",
    "test:integration": "node --test --test-concurrency=1 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON 'tests/integration/*.test.ts'",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-migrate.mjs",
    "vault:keys": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/vault-keys.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:third-party": "node scripts/check-third-party.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.25",
    "libsodium-wrappers-sumo": "0.8.4",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "lighthouse": "13.6.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}

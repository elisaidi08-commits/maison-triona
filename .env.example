# Copier en .env.local (jamais versionné). Aucune valeur réelle dans ce fichier.

# URL publique du site : canonical, sitemap, liste blanche de check:third-party.
# [À CONFIRMER : domaine de Maison Triona]
SITE_URL=http://localhost:3000

# Indexation par les moteurs de recherche. « true » uniquement en production,
# le jour de l'ouverture (docs/launch-checklist.md). Partout ailleurs : noindex.
SITE_INDEXABLE=false

# Coffre des demandes (base PostgreSQL hébergée dans l'UE, story 3.2).
# Valeurs d'exemple pour le développement local ; jamais de vraie valeur ici.
# DATABASE_URL=postgres://localhost:5432/maison_triona_dev
# Certificat de l'instance Scaleway, obligatoire en production.
# DATABASE_CA_CERT=
# Base jetable des tests d'intégration (le nom doit finir par _test).
# TEST_DATABASE_URL=postgres://localhost:5432/maison_triona_test

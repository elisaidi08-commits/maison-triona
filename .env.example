# Copier en .env.local (jamais versionné). Aucune valeur réelle dans ce fichier.

# URL publique du site : canonical, sitemap, liste blanche de check:third-party.
# [À CONFIRMER : domaine de Maison Triona]
SITE_URL=http://localhost:3000

# Indexation par les moteurs de recherche. « true » uniquement en production,
# le jour de l'ouverture (docs/launch-checklist.md). Partout ailleurs : noindex.
SITE_INDEXABLE=false

# Formulaire de contact (story 3.5, docs/architecture.md §6.7).
# Secret de l'horodatage signé et du sel des empreintes : 32 caractères au moins, obligatoire en
# production (openssl rand -base64 48). Ailleurs, un repli de développement s'applique.
FORM_SIGNING_SECRET=

# Limitation de débit (Upstash Redis, région UE). Vides : limitation inactive.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Coffre des demandes (base PostgreSQL hébergée dans l'UE, story 3.2).
# Valeurs d'exemple pour le développement local ; jamais de vraie valeur ici.
# Déployé : compte du site public, rôle site_public (insertion seule, docs/coffre-cles.md §3).
# Les migrations se lancent avec l'URL administrateur, jamais avec celle-ci.
# DATABASE_URL=postgres://localhost:5432/maison_triona_dev
# Espace /coffre et scripts/coffre-compte.mjs (story 3.2 C) : compte distinct, rôle `coffre`
# (db/roles/coffre.sql), jamais celui du site public. Sur un déploiement, une URL identique à
# DATABASE_URL est refusée.
# COFFRE_DATABASE_URL=
# Boîte d'envoi des e-mails (story 3.3) : premier essai juste après la demande et tâche planifiée
# /api/cron/envoi. Troisième compte, rôle `envoi` (db/roles/envoi.sql, docs/coffre-cles.md §3.3) :
# la boîte d'envoi seulement, aucun droit sur les demandes. Différente des deux autres : sur un
# déploiement, une URL identique à DATABASE_URL ou à COFFRE_DATABASE_URL est refusée.
# ENVOI_DATABASE_URL=
# Certificat de l'instance Scaleway, obligatoire sur tout déploiement Vercel.
# DATABASE_CA_CERT=
# Base jetable des tests d'intégration (le nom doit finir par _test).
# TEST_DATABASE_URL=postgres://localhost:5432/maison_triona_test

# Clé publique du coffre (story 3.2 B, docs/coffre-cles.md) : 44 caractères en base64, affichés par
# `npm run vault:keys -- <chemin hors du dépôt>`. Elle ne sait que sceller. Sans elle (ou sans
# DATABASE_URL), le formulaire reste fermé : « L'envoi des demandes ouvrira bientôt ».
# La clé privée n'est JAMAIS ici, ni dans aucune variable d'environnement.
VAULT_PUBLIC_KEY=

# Réservation d'appel (story 3.10, src/lib/booking/options.ts) : case « Me prévenir aussi par SMS ».
# Laisser ABSENTE tant que l'envoi des SMS n'est pas branché (story 3.12, seven, D71) : la case est masquée et
# aucun choix SMS n'est enregistré. « true » seulement une fois les SMS réellement envoyés.
# BOOKING_SMS_OPT_IN=true

# Demande de lien de réservation d'appel (story 3.9, src/lib/booking/email-hmac.ts) : secret des
# empreintes d'adresse e-mail (`booking_tokens.email_hmac`, HMAC-SHA256 ; l'adresse n'est jamais en
# base) et des clés de limitation par adresse. 32 caractères visibles au moins, sans espace
# (openssl rand -base64 48). STABLE : le changer rend les empreintes déjà en base sans rapport avec
# les nouvelles (un nouveau lien n'annule plus un lien vivant, au plus pendant 48 heures). Distinct
# de FORM_SIGNING_SECRET. Sur un déploiement Vercel, sans lui, la demande de lien reste fermée
# (« ouvrira bientôt ») ; en production, le build échoue sans lui dès que DATABASE_URL et
# TEM_SECRET_KEY sont posées. Vide en local : un repli de développement s'applique. La demande de
# lien exige aussi DATABASE_URL, VAULT_PUBLIC_KEY, ENVOI_DATABASE_URL et les variables des e-mails.
# Jamais de vraie valeur ici.
BOOKING_EMAIL_HMAC_SECRET=

# Authentification du coffre (Better Auth, story 3.2 C, docs/architecture.md §6.5).
# Secret de 32 caractères au moins (openssl rand -base64 48), obligatoire hors poste local. Il signe
# les cookies et chiffre les secrets TOTP : le changer les rend illisibles (rotation par
# BETTER_AUTH_SECRETS de Better Auth). Vide en local : un repli de développement s'applique.
BETTER_AUTH_SECRET=
# Origine publique du coffre, si elle diffère de SITE_URL (aperçu servi sous un alias de branche,
# serveur local sur un autre port). Toute autre origine est refusée à la connexion.
# BETTER_AUTH_URL=http://localhost:3000
# Ne jamais définir BETTER_AUTH_TELEMETRY ni BETTER_AUTH_TELEMETRY_ENDPOINT (télémétrie coupée).

# Envoi des e-mails par Scaleway TEM (story 3.3, docs/architecture.md §6.6,
# docs/email-deliverability.md). Tant que les cinq variables ci-dessous sont VIDES, l'envoi est
# coupé (journal `mail:disabled`) : chaque demande s'enregistre dans le coffre, sans notification.
# Une partie seulement posée (ou SITE_URL absente) : `failed:config`, même effet. Une demande
# enregistrée pendant ce temps ne sera jamais notifiée après coup : Cat la trouve dans le coffre.
# Il faut aussi ENVOI_DATABASE_URL (plus haut) et CRON_SECRET (plus bas).
# Clé d'API Scaleway (IAM) : jeux de permissions TransactionalEmailEmailApiCreate (envoyer) et
# TransactionalEmailEmailReadOnly (lire les statuts) seulement, sur le projet de la maison
# seulement. Pas de restriction par IP : les IP de sortie de Vercel ne sont pas fixes.
TEM_SECRET_KEY=
# Identifiant (UUID) du projet Scaleway qui porte le domaine d'envoi.
TEM_PROJECT_ID=
# Expéditeur, sur le domaine d'envoi vérifié dans TEM (état « checked »), au format
# « Maison Triona <adresse@mail.maisontriona.com> » ou adresse seule.
# [À CONFIRMER : adresse d'expédition]
EMAIL_FROM=
# Cat : reçoit la notification minimale (date et lien vers le coffre, rien de la demande, D06).
EMAIL_NOTIFY_TO=
# Sady : reçoit les alertes techniques (échec définitif, message non délivré).
EMAIL_ALERT_TO=

# SMS de la réservation d'appel par seven (story 3.12, D71, docs/sms-fournisseur.md) :
# src/lib/sms/config.ts. Les deux vides : aucun SMS ne part. L'une sans l'autre : erreur franche.
# Clé d'API du compte seven de la société, jamais une clé personnelle. Jamais de vraie valeur ici.
SEVEN_API_KEY=
# Nom d'expéditeur : « Triona » (D71). 3 à 11 lettres ou chiffres, sans espace ; enregistré auprès
# de seven pour la France. En Belgique, l'opérateur le remplace par un numéro court.
SMS_SENDER=

# Tâches planifiées Vercel Cron (vercel.json) : conservation du coffre (story 3.2 D,
# /api/cron/retention, chaque jour à 3 h UTC) et boîte d'envoi des e-mails (story 3.3,
# /api/cron/envoi, toutes les 5 minutes : reprises des envois, suivi de la livraison, purge).
# Vercel Cron envoie cette valeur dans l'en-tête « Authorization: Bearer … » ; sans elle, ou avec une
# valeur de moins de 32 caractères (ou avec une espace), les deux routes répondent toujours 401 :
# la conservation n'efface rien, et le premier essai d'un e-mail part quand même, mais rien n'est
# repris ni suivi. Lettres et chiffres seulement : openssl rand -hex 32. Figée au build : redéployer
# après un changement. Environnement Production seulement : Vercel ne lance les tâches que sur le
# déploiement de production. Aucun repli de développement ; en production, le build échoue sans
# elle dès que COFFRE_DATABASE_URL ou TEM_SECRET_KEY est posée. Jamais de vraie valeur ici.
CRON_SECRET=
